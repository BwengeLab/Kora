{
  "name": "kora-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "proto:gen": "buf generate ../proto --template buf.gen.yaml",
    "dev:web": "pnpm --filter @kora/web dev",
    "build:web": "pnpm --filter @kora/web build",
    "preview:web": "pnpm --filter @kora/web preview",
    "dev:desktop": "pnpm --filter @kora/desktop dev",
    "build:desktop": "pnpm --filter @kora/desktop build",
    "test": "pnpm -r --parallel run test",
    "e2e": "playwright test",
    "lint": "eslint \"{shared,web}/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{shared,web}/src/**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "pnpm -r --parallel run typecheck"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.39.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.6.1",
    "@playwright/test": "^1.47.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
